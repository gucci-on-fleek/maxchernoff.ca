# Base configuration
htop_version=3.4.1
config_reader_min_version=3

# General settings
color_scheme=0
enable_mouse=1
delay=12.5
hide_function_bar=0

# Process listing settings
hide_kernel_threads=0
hide_userland_threads=1
hide_running_in_container=0
shadow_other_users=0
show_thread_names=0
show_program_path=1
highlight_base_name=1
highlight_deleted_exe=0
shadow_distribution_path_prefix=0
show_merged_command=0
update_process_names=0
tree_view=0

# Process list layout
screen:Main=PID USER IO_RATE PERCENT_MEM M_PSS PERCENT_CPU TIME STATE Command
.sort_key=PERCENT_CPU
.tree_sort_key=PERCENT_MEM
.tree_view=0
.sort_direction=-1
.tree_sort_direction=-1

# Header settings
detailed_cpu_time=1
cpu_count_from_one=0
show_cpu_usage=1
show_cpu_frequency=0
show_cpu_temperature=0
account_guest_in_cpu_meter=1
show_cached_memory=1

# Header layout

# # Lots of processors
# header_layout=three_30_30_40
# column_meters_0=LeftCPUs
# column_meter_modes_0=1
# column_meters_1=RightCPUs
# column_meter_modes_1=1
# column_meters_2=Hostname Systemd PressureStallCPUSome PressureStallIOSome PressureStallMemorySome NetworkIO Memory Swap
# column_meter_modes_2=2 2 1 1 1 2 1 1

# Few processors
header_layout=two_50_50
column_meters_0=AllCPUs Memory Swap
column_meter_modes_0=1 1 1
column_meters_1=Hostname Systemd PressureStallCPUSome PressureStallIOSome PressureStallMemorySome NetworkIO
column_meter_modes_1=2 2 1 1 1 2
