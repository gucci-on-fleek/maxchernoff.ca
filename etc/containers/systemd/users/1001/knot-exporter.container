[Container]
Image=maxchernoff.ca/knot-exporter:latest
StopSignal=SIGINT

Network=private
Volume=%t/knot:/run/knot/:rw,z

User=1000
Group=0

ReadOnly=true
ReadOnlyTmpfs=false

# Metrics
Exec=\
    --web-listen-addr=0.0.0.0 \
    --web-listen-port=9100

PublishPort=${metrics_knot_ip}:9100:9100

[Unit]
ConditionHost=|hydrogen
ConditionHost=|maxchernoff.ca
ConditionHost=|helium
Wants=knot.service
After=knot.service

[Service]
EnvironmentFile=/usr/local/share/metrics-addresses/%H-%u.conf
Restart=always
SuccessExitStatus=130
TimeoutStopSec=15s

[Install]
WantedBy=default.target
