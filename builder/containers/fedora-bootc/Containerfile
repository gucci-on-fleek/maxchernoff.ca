FROM maxchernoff.ca/fedora-bootc-base:latest as base

FROM base as kernel
ARG IMAGE_ID
RUN <<EOF
    set -euxo pipefail
    export SOURCE_DATE_EPOCH=0

    # Get the composefs ID
    {
        echo "graphRootMounted=1"
        echo "imageid=$IMAGE_ID"
    } > /run/.containerenv

    # Add the composefs ID to the kernel command line
    echo "composefs=$(\
        bootc container compute-composefs-digest-from-storage \
    )" >> /usr/lib/kernel/cmdline
    echo "rw" >> /usr/lib/kernel/cmdline
    grep --perl-regexp --quiet '^composefs=.{5}' /usr/lib/kernel/cmdline

    # UKI generation
    mkdir -p /usr/lib/firmware
    ln -s /usr/share/pki/rpm-gpg /etc/pki/rpm-gpg
    dnf makecache

    kernel-install add-all --verbose

    mkdir -p /boot/EFI/BOOT/ /boot/EFI/systemd/
    cp /usr/lib/systemd/boot/efi/systemd-bootx64.efi /boot/EFI/BOOT/BOOTX64.EFI
    cp /usr/lib/systemd/boot/efi/systemd-bootx64.efi /boot/EFI/systemd/systemd-bootx64.efi

    # Cleanup
    rm -rf /run/containers

    # Lint the bootc container
    bootc container lint --no-truncate --fatal-warnings || true

    # Clamp the timestamps
    find /boot -depth -exec touch --no-dereference --date="@0" '{}' +
EOF

FROM base AS bootable
COPY --from=kernel /boot /boot
