debugfs=off
ia32_emulation=0
init_on_alloc=1
init_on_free=1
lockdown=confidentiality
mitigations=auto
module.sig_enforce=1
page_alloc.shuffle=1
pti=on
randomize_kstack_offset=on
root=gpt-auto
rootflags=compress=zstd:3,noatime,lazytime,nodev
softdog.soft_active_on_boot=1
systemd.credentials_boot_policy=off
systemd.getty_auto=container
systemd.image_policy=root=encrypted:swap=encrypted+absent+unused:esp=unprotected
systemd.ssh_auto=no
vsyscall=none
