[Unit]
Description=Bind mount /var/etc/hostname to /etc/hostname
ConditionPathExists=/etc/initrd-release

DefaultDependencies=no
After=initrd-root-fs.target
Before=initrd-fs.target

[Mount]
What=/sysroot/var/etc/hostname
Where=/sysroot/etc/hostname
Options=bind

[Install]
WantedBy=initrd-fs.target
