[Unit]
Description=Update TeX Live

Wants=install-texlive.service
After=install-texlive.service
After=network.target

[Service]
Type=oneshot
User=tex
UMask=0002

ExecStart=/usr/local/bin/update-texlive.sh
ExecStart=-/usr/local/bin/update-context.sh
ExecStart=+restorecon -RDT0 /var/lib/tex/texlive /var/lib/tex/context-installer/tex

CapabilityBoundingSet=
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateUsers=true
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tex
