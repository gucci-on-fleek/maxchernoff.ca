[Unit]
Description=Bind mount /var/etc/hostname to /etc/hostname
Before=systemd-hostnamed.service

[Mount]
What=/var/etc/hostname
Where=/etc/hostname
Options=bind

[Install]
WantedBy=systemd-hostnamed.service
WantedBy=local-fs.target
