[Unit]
Description=First boot setup
ConditionFileNotEmpty=|!/var/etc/first-boot-successful

[Service]
Type=oneshot
ExecStart=restorecon -RDT0 /
ExecStart=sh -c 'if [ -d /var/etc/hostname ]; then rmdir /var/etc/hostname; touch /var/etc/hostname; fi'
ExecStart=touch /var/etc/first-boot-successful
