[Unit]
Description=OpenSSH Ed25519 Server Key Generation
ConditionFileNotEmpty=|!/var/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -q \
    -t ed25519 \
    -f /var/etc/ssh/ssh_host_ed25519_key \
    -N ""

[Install]
WantedBy=sshd-keygen.target
