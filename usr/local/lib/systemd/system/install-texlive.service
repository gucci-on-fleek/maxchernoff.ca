[Unit]
Description=Install TeX Live

After=network.target
ConditionPathIsDirectory=!/var/lib/tex/texlive

[Service]
Type=oneshot
User=tex
UMask=0002

ExecStart=/usr/local/bin/install-texlive.sh
ExecStart=/usr/local/bin/install-context.sh
ExecStart=restorecon -RDT0 /var/lib/tex/texlive /var/lib/tex/context-installer/tex

CapabilityBoundingSet=
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateUsers=true
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tex
