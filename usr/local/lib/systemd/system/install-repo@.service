[Unit]
Description=Install the files from the server Git repository
After=pull-repo@%i.service
Requires=pull-repo@%i.service

[Service]
User=root
Type=oneshot
RestrictSUIDSGID=false

ExecStart=systemd-confext refresh --always-refresh=yes
ExecStart=systemd-sysext refresh --always-refresh=yes
ExecStart=systemctl --system daemon-reload
ExecStart=-systemctl --user --machine="builder@" daemon-reload
ExecStart=-systemctl --user --machine="max@" daemon-reload
ExecStart=-systemctl --user --machine="web@" daemon-reload
ExecStart=-systemctl --user --machine="woodpecker@" daemon-reload
ExecStart=notify-all
