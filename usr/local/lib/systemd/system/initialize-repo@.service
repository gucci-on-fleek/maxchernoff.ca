[Unit]
Description=Initializes the server Git repository

Wants=network-online.target
After=network-online.target

ConditionPathExists=/var/lib/%i/.git

[Service]
# Limit the permissions to the minimum necessary
User=repo

Type=oneshot
WorkingDirectory=/var/lib/%i

# For "generic" repos, do nothing. This will be overridden in the per-repo
# drop-in files.
ExecStart=/usr/bin/true

