[Match]
Name=enx*
Host=boron

[Network]
Description=WAN Interface
DHCP=no

# IPv4
Address=!!network.boron.ipv4!!/24
Gateway=216.18.193.1
DNS=1.1.1.1 1.0.0.1

# IPv6
Address=!!network.boron.ipv6!!/64
Gateway=2607:f2d8:401b::1
DNS=2606:4700:4700::1111 2606:4700:4700::1001

# Traffic shaping
[CAKE]
Bandwidth=0.95G
FlowIsolationMode=triple
PriorityQueueingPreset=besteffort
SplitGSO=false
