[Match]
Name=enx*
Host=lithium

[Network]
Description=WAN Interface
DHCP=no

# IPv4
Address=!!network.lithium.ipv4!!/24
Gateway=185.99.135.1
DNS=1.1.1.1 1.0.0.1

# IPv6
Address=!!network.lithium.ipv6!!/64
Gateway=2a0d:d907:3::1
DNS=2606:4700:4700::1111 2606:4700:4700::1001

# Traffic shaping
[CAKE]
Bandwidth=0.95G
FlowIsolationMode=triple
PriorityQueueingPreset=besteffort
SplitGSO=false
