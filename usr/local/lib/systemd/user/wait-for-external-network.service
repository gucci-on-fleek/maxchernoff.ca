[Unit]
DefaultDependencies=no
Before=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'until systemctl --system is-active network-online.target; do sleep 0.5; done'

[Install]
WantedBy=network-online.target
