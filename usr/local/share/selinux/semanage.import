# Booleans
boolean --deleteall

# Allow unprivileged users to host network servers
boolean --modify selinuxuser_tcp_server --on
boolean --modify selinuxuser_udp_server --on

# Allow unprivileged users to run containers
boolean --modify container_manage_cgroup --on
boolean --modify domain_can_mmap_files --on

# Disallow execution of non-system files by the specified users.
boolean --modify auditadm_exec_content --off
boolean --modify container_user_exec_content --off
boolean --modify dbadm_exec_content --off
boolean --modify guest_exec_content --off
boolean --modify logadm_exec_content --off
boolean --modify secadm_exec_content --off
boolean --modify user_exec_content --off

# Hardening
boolean --modify container_use_dri_devices --off
boolean --modify deny_bluetooth --on
boolean --modify deny_execmem --on
boolean --modify httpd_builtin_scripting --off
boolean --modify httpd_enable_cgi --off
boolean --modify selinuxuser_execstack --off
boolean --modify selinuxuser_rw_noexattrfile --off

# Load the custom policies
module --deleteall
module --add /usr/local/share/selinux/local-required-fallbacks.cil
module --add /usr/local/share/selinux/local-allow-containers.cil
module --add /usr/local/share/selinux/local-custom-containers.cil
module --add /usr/local/share/selinux/local-prometheus.cil
module --add /usr/local/share/selinux/local-systemd.cil
module --add /usr/share/udica/templates/base_container.cil
module --add /usr/share/udica/templates/net_container.cil

# Set the container file contexts
fcontext --deleteall
fcontext --add --seuser system_u --type lib_t '/sysroot/composefs(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/repo/triggers(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/tex/context-installer/tex(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/tex/texlive(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/web/caddy/logs(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/web/dmarc-metrics/data(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/web/grafana/data(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/web/knot/storage(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/web/maddy/data(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/web/overleaf(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/web/victoria-logs/data(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/web/victoria-metrics/data(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/web/woodpecker/data(/.*)?'
fcontext --add --seuser user_u --type container_file_t    '/var/home/woodpecker/woodpecker/config(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/etc/containers(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/builder/containers(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/etc/common(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/usr(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/web/caddy(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/web/container-registry(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/web/dmarc-metrics(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/web/dnscontrol(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/web/flask(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/web/goaccess(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/web/grafana(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/web/knot(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/web/maddy(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/repo/maxchernoff.ca/web/victoria-metrics/config(/.*)?'
fcontext --add --seuser user_u --type container_ro_file_t '/var/home/web/caddy/context-wiki(/.*)?'

# Set the file context equivalents
fcontext --add '/var/home/repo/maxchernoff.ca/builder/.config' --equal '/var/home/builder/.config'
fcontext --add '/var/home/repo/maxchernoff.ca/max/.config' --equal '/var/home/max/.config'
fcontext --add '/var/home/repo/maxchernoff.ca/tex/.config' --equal '/var/home/tex/.config'
fcontext --add '/var/home/repo/maxchernoff.ca/web/.config' --equal '/var/home/web/.config'
fcontext --add '/var/home/repo/maxchernoff.ca/woodpecker/.config' --equal '/var/home/woodpecker/.config'

# Missing policy definition
fcontext --add '/etc/systemd/user' --equal '/usr/lib/systemd/user'

# Allow max to sudo
login --deleteall
login --add --seuser staff_u  --range 's0-s0:c0.c1023' max
login --modify --seuser sysadm_u --range 's0-s0:c0.c1023' root

# Let all users run containers
user --modify user_u --range s0-s0:c0.c1023
login --modify --seuser user_u --range 's0-s0:c0.c1023' __default__
