[Container]
Image=maxchernoff.ca/flask:latest
StopSignal=SIGINT
Network=flask.network

Volume=%E/config/flask/:/srv:ro,exec
Volume=/var/lib/triggers/:/root/triggers:rw
Exec=/srv/app.py
EnvironmentFile=%d/webhook_secret

ReadOnly=true
ReadOnlyTmpfs=false

[Service]
Restart=always
TimeoutStopSec=15s
LoadCredential=webhook_secret

# Run at a higher priority
!!priorities.high!!

[Unit]
ConditionHost=|hydrogen
ConditionHost=|maxchernoff.ca
ConditionHost=|helium
Wants=network-online.target
After=network-online.target
After=container-registry.service

[Install]
WantedBy=caddy.service
Also=flask-network.service
