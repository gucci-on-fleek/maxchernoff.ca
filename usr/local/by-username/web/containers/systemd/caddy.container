[Container]
Image=maxchernoff.ca/caddy:latest
StopTimeout=10
Notify=true

ReadOnly=true
ReadOnlyTmpfs=false

Environment="GODEBUG=multipathtcp=1"
EnvironmentFile=%d/caddy_tsig
EnvironmentFile=%d/caddy_http_credentials

Volume=%E/config/caddy/etc:/etc/caddy:ro,noexec
Volume=%E/config/caddy/static:/srv:ro,noexec
Volume=%h/data/caddy/data:/data:rw,Z,noexec,U
Volume=%h/data/caddy/logs:/var/log/caddy/:rw,z,noexec,U
Volume=%h/data/caddy/config:/config:rw,Z,noexec,U
Volume=%h/data/caddy/context-wiki:/srv/tools/context-wiki:ro,noexec

Network=caddy.network
Network=container-registry.network
Network=flask.network
Network=overleaf.network
Network=prometheus.network
Network=woodpecker.network

# Metrics
PublishPort=${metrics_caddy_ip}:9100:9100

[Service]
EnvironmentFile=/usr/local/share/metrics-addresses/%H-%u.conf
Restart=always
TimeoutStopSec=15s

LoadCredential=caddy_tsig
LoadCredential=caddy_http_credentials

# Run at a higher priority
!!priorities.high!!

[Unit]
ConditionHost=|hydrogen
ConditionHost=|maxchernoff.ca
ConditionHost=|helium
Wants=network-online.target
After=network-online.target
Requires=caddy.socket
After=caddy.socket

[Install]
WantedBy=default.target
Also=caddy-network.service
