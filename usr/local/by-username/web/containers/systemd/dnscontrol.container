[Container]
Image=ghcr.io/stackexchange/dnscontrol:latest

EnvironmentFile=%d/dnscontrol_secrets
Network=private
Volume=%E/config/dnscontrol:/dns:ro,z
Exec=push --full

[Unit]
ConditionHost=|hydrogen
ConditionHost=|maxchernoff.ca
ConditionHost=|helium
After=knot.service
Wants=knot.service
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=no
ExecStartPost=sleep 15
LoadCredential=dnscontrol_secrets
