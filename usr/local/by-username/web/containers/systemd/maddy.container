[Container]
Image=docker.io/foxcpp/maddy:latest
Entrypoint=["/bin/maddy"]
Exec=-config /etc/maddy/maddy.conf run

User=1000

Volume=%h/data/maddy/data:/data:rw,Z,noexec
Volume=%E/config/maddy/config:/etc/maddy:ro,noexec
Volume=%d/maddy-users.conf:/etc/maddy/maddy-users.conf:ro,noexec,U,Z

# Allow external access so that we can send to other MX servers
Network=maddy-external.network
# Internal network to only allow access to Maddy, and not the outside world
Network=email.network
# Let services on the localhost access Maddy
PublishPort=!!email.ipv4!!:587:587

# Metrics
PublishPort=${metrics_maddy_ip}:9100:9100

[Service]
EnvironmentFile=/usr/local/share/metrics-addresses/%H-%u.conf
Restart=always
LoadCredential=maddy-users.conf

# Run at a higher priority
!!priorities.high!!

[Unit]
ConditionHost=|hydrogen
ConditionHost=|maxchernoff.ca
ConditionHost=|helium
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=default.target
