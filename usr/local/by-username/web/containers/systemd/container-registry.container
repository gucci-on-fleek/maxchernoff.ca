[Container]
Image=docker.io/library/registry:3
Network=container-registry.network

# Config
Volume=%E/config/container-registry:/etc/distribution/:ro,noexec

# Image Storage
Volume=container-registry.volume:/var/lib/registry:rw
Environment="OTEL_LOGS_EXPORTER=none"
Environment="OTEL_METRICS_EXPORTER=none"
Environment="OTEL_TRACES_EXPORTER=none"

# Metrics
PublishPort=${metrics_registry_ip}:9100:9100

[Service]
EnvironmentFile=/usr/local/share/metrics-addresses/%H-%u.conf
Restart=always
SuccessExitStatus=2
RuntimeMaxSec=12.25h

[Unit]
ConditionHost=|hydrogen
ConditionHost=|maxchernoff.ca
ConditionHost=|helium
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=caddy.service
Also=container-registry-network.service
