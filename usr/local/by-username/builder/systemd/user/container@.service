[Unit]
After=podman.socket network-online.target
Requires=podman.socket

[Service]
Type=oneshot
RemainAfterExit=no
Slice=container.slice
LoadCredential=containers-auth.json

ExecStart=/usr/local/bin/build-container \
    --debug \
    --directory=%E/config/%i \
    --tag=%i:latest \
    --config=%E/config/build-container.toml

Restart=on-failure
RestartSec=5min

!!priorities.low!!

[Install]
WantedBy=update-all.target
