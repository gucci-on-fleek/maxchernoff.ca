[Container]
Image=docker.io/jgosmann/dmarc-metrics-exporter:latest
StopSignal=SIGINT
Volume=%h/dmarc-metrics/data/:/var/lib/dmarc-metrics-exporter:rw,Z,noexec
Volume=%d/dmarc-metrics-exporter.json:/etc/dmarc-metrics-exporter.json:ro,noexec,U,Z

ReadOnly=true
ReadOnlyTmpfs=false

# Metrics
EnvironmentFile=/usr/local/share/metrics-addresses/%H-%u.conf
PublishPort=${metrics_dmarc_metrics_ip}:9100:9100

[Unit]
Wants=network-online.target
After=network-online.target

[Service]
Restart=always
LoadCredential=dmarc-metrics-exporter.json

[Install]
WantedBy=default.target
